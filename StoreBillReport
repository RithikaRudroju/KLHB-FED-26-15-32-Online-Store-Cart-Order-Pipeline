
import java.util.*;
import java.util.stream.Collectors;

public class StoreBillReport {
    public static void main(String[] args) {
        List<Double> prices = Arrays.asList(
            60.0, 45.0, 180.0, 750.0, 499.0
        );

        double total = prices.stream()
                .reduce(0.0, (a, b) -> a + b);

        double average = prices.stream()
                .mapToDouble(price -> price)
                .average()
                .orElse(0.0);

        List<Double> expensiveProducts = prices.stream()
                .filter(price -> price > 100)
                .collect(Collectors.toList());

        String report = prices.stream()
                .map(price -> "Rs. " + price)
                .collect(Collectors.joining(", "));

        System.out.println("Total value: Rs. " + total);
        System.out.println("Average price: Rs. " + average);
        System.out.println(
            "Products above Rs. 100: " + expensiveProducts
        );
        System.out.println("Price report: " + report);
    }
}
